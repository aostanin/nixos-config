# Intel XMM7560 (8086:7560) FCC unlock

if [[ "$FCC_UNLOCK_DEBUG_LOG" == '1' ]]; then
    exec 3>&1 4>&2
    trap 'exec 2>&4 1>&3' 0 1 2 3
    exec 1>>/var/log/mm-xmm7560-fcc.log 2>&1
fi

# require program name and at least 2 arguments
[ $# -lt 2 ] && exit 1

# first argument is DBus path, not needed here
shift

# second and next arguments are control port names
for PORT in "$@"; do
  # match port type in Linux 5.14 and newer
  grep -q AT "/sys/class/wwan/$PORT/type" 2>/dev/null && {
    AT_PORT=$PORT
    break
  }
  # match port name in Linux 5.13
  echo "$PORT" | grep -q AT && {
    AT_PORT=$PORT
    break
  }
done

# fail if no AT port exposed
[ -n "$AT_PORT" ] || exit 2

DEVICE=/dev/${AT_PORT}

at_command() {
    exec 99<>"$DEVICE"
    printf '%s\r' "$1" >&99
    read -r answer <&99
    read -r answer <&99
    echo "$answer"
    exec 99>&-
}

log() {
    echo "$1"
}

error() {
    echo "$1" >&2
}

reverseWithLittleEndian() {
    num="$1"
    printf "%08x" $(("0x${num:6:2}${num:4:2}${num:2:2}${num:0:2}"))
}

# First string of SMBIOS type 133, the "model id in bios" the modem hashes.
# Read from DMI sysfs rather than dmidecode, to avoid executing another binary.
dmi_oem_string() {
    entry='/sys/firmware/dmi/entries/133-0'
    len="$(cat "$entry/length" 2>/dev/null)" || return 1
    [ -n "$len" ] || return 1
    tail -c "+$((len + 1))" "$entry/raw" 2>/dev/null | tr '\000' '\n' | head -n 1
}

# Vendor ID hashes for OEMs that do not publish the model id in SMBIOS.
# 3df8c719 is SHA-256("KHOIHGIUCCHHII"), the Lenovo value, which Lenovo firmware
# does publish. bb23be7f is SHA-256("DW5823EFCCLOCK"), the constant Dell's own
# ModemAuthenticator.exe uses on machines that pass its identity checks.
KNOWN_VENDOR_ID_HASHES='3df8c719 bb23be7f'

VENDOR_ID_HASHES=''
DEVCODE="$(dmi_oem_string)"
if [ -n "$DEVCODE" ]; then
    VENDOR_ID_HASHES="$(printf '%s' "$DEVCODE" | sha256sum | cut -c '1-8')"
    log "Derived vendor ID hash $VENDOR_ID_HASHES from SMBIOS type 133"
else
    log "No OEM string in SMBIOS type 133, falling back to known vendor ID hashes"
fi

for KNOWN_VENDOR_ID_HASH in $KNOWN_VENDOR_ID_HASHES; do
    case " $VENDOR_ID_HASHES " in
        *" $KNOWN_VENDOR_ID_HASH "*) ;;
        *) VENDOR_ID_HASHES="$VENDOR_ID_HASHES $KNOWN_VENDOR_ID_HASH" ;;
    esac
done

i=1
for VENDOR_ID_HASH in $VENDOR_ID_HASHES; do
    while [ "$i" -le 9 ]; do
        log "Requesting challenge from WWAN modem (attempt #$i, hash $VENDOR_ID_HASH)"
        RAW_CHALLENGE="$(at_command 'at+gtfcclockgen')"
        CHALLENGE="$(echo "$RAW_CHALLENGE" | grep -o '0x[0-9a-fA-F]\+' | awk '{print $1}')"

        [ -n "$CHALLENGE" ] && {
            log "Got challenge from modem: $CHALLENGE"
            HEX_CHALLENGE="$(printf '%08x' "$CHALLENGE")"
            REVERSE_HEX_CHALLENGE="$(reverseWithLittleEndian "$HEX_CHALLENGE")"
            COMBINED_CHALLENGE="$REVERSE_HEX_CHALLENGE$(printf '%.8s' "$VENDOR_ID_HASH")"
            RESPONSE_HASH="$(echo "$COMBINED_CHALLENGE" | xxd -r -p | sha256sum | cut -d ' ' -f 1)"
            TRUNCATED_RESPONSE="$(printf '%.8s' "$RESPONSE_HASH")"
            REVERSED_RESPONSE="$(reverseWithLittleEndian "$TRUNCATED_RESPONSE")"
            RESPONSE="$(printf '%d' "0x$REVERSED_RESPONSE")"

            log "Sending response to WWAN modem: $RESPONSE"
            UNLOCK_RESPONSE="$(at_command "at+gtfcclockver=$RESPONSE")"

            UNLOCK_RESULT="$(echo "$UNLOCK_RESPONSE" | tr -d '\r' | grep -o '[0-9][0-9]*' | tail -1)"
            [ "$UNLOCK_RESULT" = '1' ] && {
                log "FCC unlock succeeded"
                at_command 'at+gtfcclockmodeunlock' >/dev/null
                # Not in !1496: the XMM7560 stays at CFUN 0 after unlocking and
                # MBIM radio-state set then fails Busy, so MM can never enable it.
                at_command 'at+cfun=1' >/dev/null
                log "FCC lock state: $(at_command 'at+gtfcclockstate')"
                exit 0
            } || {
                error "FCC unlock failed. Got result: $UNLOCK_RESULT"
                break
            }
        } || error "Failed to obtain FCC challenge. Got: $RAW_CHALLENGE"

        sleep 0.5
        i="$((i + 1))"
    done
done

exit 2
