+// A JPEG cut short in transit (e.g. a lost USB isochronous payload) makes the
+// Raspberry Pi hardware decoder end its stream, which the "last buffer"
+// restart above does not recover from.
+static bool links_jpeg_is_complete(buffer_t *buf)
+{
+  const unsigned char *data = buf->start;
+
+  if (buf->buf_list->fmt.format != V4L2_PIX_FMT_MJPEG &&
+      buf->buf_list->fmt.format != V4L2_PIX_FMT_JPEG)
+    return true;
+  if (!data)
+    return true;
+  return buf->used >= 4 && data[buf->used - 2] == 0xFF && data[buf->used - 1] == 0xD9;
+}
